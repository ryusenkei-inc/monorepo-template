{
  "name": "@ryusenkei/monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm typecheck && prose-lint && ryusenkei-conventions check",
    "lint:prose": "prose-lint",
    "typecheck": "pnpm -r --if-present typecheck && tsc",
    "test": "vitest run --passWithNoTests",
    "env:push": "node scripts/env.ts push",
    "repo:settings": "ryusenkei-repo-settings",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@ryusenkei/conventions": "^0.8.1",
    "@ryusenkei/prose-lint": "^0.2.0",
    "@ryusenkei/scripts": "^0.1.0",
    "@types/node": "^26.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
